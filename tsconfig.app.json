{
    "extends": "./tsconfig.json",
    "compilerOptions": {
      "outDir": "./dist",
      "noEmit": true,
      "module": "esnext",
      "moduleResolution": "bundler",
      "esModuleInterop": true,
      "allowSyntheticDefaultImports": true
    },
    "include": ["src"],
    "exclude": ["node_modules", "dist"]
  }